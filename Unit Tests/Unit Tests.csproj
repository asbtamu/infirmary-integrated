<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Unit_Tests</RootNamespace>

    <IsPackable>false</IsPackable>

    <ApplicationIcon />

    <OutputType>Library</OutputType>

    <StartupObject></StartupObject>

    <TargetFramework>net10.0</TargetFramework>

    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.8.3" />
    <PackageReference Include="MSTest.TestFramework" Version="3.8.3" />
    <!-- The shared II Library compiles against Avalonia (Settings.Window); same versions as the apps -->
    <PackageReference Include="Avalonia" Version="11.3.0" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plain C# (no UI), so II Command's session log is tested directly -->
    <Compile Include="..\II Command\Classes\SessionLog.cs" Link="Linked\SessionLog.cs" />
    <Compile Include="..\II Command\Classes\StationMap.cs" Link="Linked\StationMap.cs" />
  </ItemGroup>

  <Import Project="..\II Library\II Library.projitems" Label="Shared" />
</Project>