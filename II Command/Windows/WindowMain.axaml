<Window
	x:Class="IICMD.WindowMain"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Name="wdwMain"
	Title="Infirmary Integrated: Command"
	Width="1600"
	Height="900"
	WindowStartupLocation="CenterScreen"
	mc:Ignorable="d">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Toolbar -->
    <Border Grid.Row="0" Padding="8" Background="#F0F0F0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button
						Name="btnAddRoom"
						Grid.Column="0"
						Margin="0,0,6,0"
						Content="+ Add Room"
						Click="OnClick_AddRoom" />

        <Button
						Name="btnLoadLayout"
						Grid.Column="1"
						Margin="0,0,6,0"
						Content="Load Layout…"
						Click="OnClick_LoadLayout" />

        <Button
						Name="btnSaveLayout"
						Grid.Column="2"
						Margin="0,0,6,0"
						Content="Save Layout…"
						Click="OnClick_SaveLayout" />

        <StackPanel
						Grid.Column="4"
						Orientation="Horizontal"
						VerticalAlignment="Center"
						Margin="0,0,10,0">
          <TextBlock
							Text="Mirror server:"
							VerticalAlignment="Center"
							Margin="0,0,6,0" />
          <TextBox
							Name="tbServerAddress"
							MinWidth="320" />
        </StackPanel>

        <Button
						Name="btnBroadcastAll"
						Grid.Column="5"
						Content="Broadcast All"
						Click="OnClick_BroadcastAll" />
      </Grid>
    </Border>

    <!-- Room cards -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <WrapPanel
					Name="panelRooms"
					Margin="6" />
    </ScrollViewer>
  </Grid>
</Window>
