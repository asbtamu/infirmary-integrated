<Window
	x:Class="IICMD.DialogVitals"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="Vitals"
	Width="340"
	SizeToContent="Height"
	CanResize="False"
	WindowStartupLocation="CenterOwner"
	mc:Ignorable="d">

  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
  </Window.Styles>

  <StackPanel Margin="14" Spacing="6">

    <TextBlock Name="txtRoom" FontWeight="Bold" FontSize="15" Margin="0,0,0,6" />

    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

      <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Rhythm" />
      <ComboBox Grid.Row="0" Grid.Column="1" Name="comboRhythm" HorizontalAlignment="Stretch" Margin="0,3" />

      <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="HR" />
      <NumericUpDown Grid.Row="1" Grid.Column="1" Name="numHR" Minimum="0" Maximum="300" Increment="1" FormatString="0" />

      <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="BP systolic" />
      <NumericUpDown Grid.Row="2" Grid.Column="1" Name="numNSBP" Minimum="0" Maximum="300" Increment="1" FormatString="0" />

      <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="BP diastolic" />
      <NumericUpDown Grid.Row="3" Grid.Column="1" Name="numNDBP" Minimum="0" Maximum="300" Increment="1" FormatString="0" />

      <TextBlock Grid.Row="4" Grid.Column="0" Classes="label" Text="SpO2" />
      <NumericUpDown Grid.Row="4" Grid.Column="1" Name="numSPO2" Minimum="0" Maximum="100" Increment="1" FormatString="0" />

      <TextBlock Grid.Row="5" Grid.Column="0" Classes="label" Text="RR" />
      <NumericUpDown Grid.Row="5" Grid.Column="1" Name="numRR" Minimum="0" Maximum="100" Increment="1" FormatString="0" />

      <TextBlock Grid.Row="6" Grid.Column="0" Classes="label" Text="EtCO2" />
      <NumericUpDown Grid.Row="6" Grid.Column="1" Name="numETCO2" Minimum="0" Maximum="100" Increment="1" FormatString="0" />

      <TextBlock Grid.Row="7" Grid.Column="0" Classes="label" Text="T °C" />
      <NumericUpDown Grid.Row="7" Grid.Column="1" Name="numT" Minimum="25" Maximum="45" Increment="0.1" FormatString="0.0" />
    </Grid>

    <TextBlock Name="txtStatus" FontSize="12" Foreground="DimGray" Margin="0,6,0,0" TextWrapping="Wrap" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,8,0,0">
      <Button Name="btnReload" Content="Reload from room" Click="OnClick_Reload" />
      <Button Name="btnApply" Content="Apply" Click="OnClick_Apply" />
      <Button Name="btnClose" Content="Close" Click="OnClick_Close" />
    </StackPanel>
  </StackPanel>
</Window>
